# KI LEGENDS — wzór zmiennych środowiskowych. Skopiuj do .env (lub wpisz w Coolify) i uzupełnij.
# NIGDY nie commituj prawdziwego pliku .env. Pełny opis: ZMIENNE-SRODOWISKOWE.md.

# --- Budowanie (wbudowywane w kod przeglądarki; to wartości PUBLICZNE) ---
VITE_SUPABASE_URL=https://TWOJ-BACKEND.example.pl
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# --- Serwer Node.js (tajne — tylko w Coolify / .env na serwerze) ---
SUPABASE_URL=https://TWOJ-BACKEND.example.pl
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Losowe, min. 32 znaki, np.: openssl rand -base64 48
SESSION_SECRET=
# Hasło do prywatnej strony /test (szkice)
SITE_PASSWORD=

# --- Opcjonalne ---
# Znacznik wersji obrazów (do szybkiego powrotu do poprzedniej wersji)
KI_RELEASE=latest
# Port na hoście, tylko przy uruchomieniu bez Coolify (odkomentuj "ports" w docker-compose.yml)
KI_HTTP_PORT=8080
