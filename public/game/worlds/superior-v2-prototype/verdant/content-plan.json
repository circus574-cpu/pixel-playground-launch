{"settlements":[{"bounds":{"height":2048,"width":3072,"x":47529.0,"y":33684.0},"id":"verdant-capital","kind":"capital","name":"Zielona Przystań","services":["shop","hall","inn","smithy","depot","arena"],"x":49024.0,"y":34944.0},{"bounds":{"height":2560,"width":3072,"x":17864.93739,"y":25904.518924999997},"id":"verdant-town-1","kind":"town","name":"Verdantia — miasto 2","services":["shop","hall","inn","smithy","depot","arena"],"x":19400.93739,"y":27184.518924999997},{"bounds":{"height":2560,"width":3072,"x":35848.93739,"y":17808.518924999997},"id":"verdant-town-2","kind":"town","name":"Verdantia — miasto 3","services":["shop","hall","inn","smithy","depot","arena"],"x":37384.93739,"y":19088.518924999997},{"bounds":{"height":2560,"width":3072,"x":57320.93739,"y":19888.518924999997},"id":"verdant-town-3","kind":"town","name":"Verdantia — miasto 4","services":["shop","hall","inn","smithy","depot","arena"],"x":58856.93739,"y":21168.518924999997}],"npcs":[{"dialogue":"Witaj w Zielonej Przystani. Odwiedź Rynek na północ od fontanny i wróć po 40 XP oraz 40 monet na pierwsze wyposażenie. Miasto jest bezpieczne. Usługi znajdziesz w osobnych dzielnicach — otwórz plan miasta.","id":"accepted-guide","name":"Aira","role":"Przewodniczka miasta","tint":11071695,"x":49099.0,"y":34934.0},{"dialogue":"W mieście nie ma dzików ani wrogich spawnów. Najpierw przygotuj wyposażenie i poćwicz w Domu Treningu. Wyprawy i przeciwnicy za bramą powstaną w następnym etapie.","id":"accepted-hunter","name":"Ren","role":"Strażnik bramy","tint":16762788,"x":49739.0,"y":34834.0},{"building":"shop","id":"accepted-merchant","name":"Mio","role":"Kupczyni","tint":14070783,"x":48029.0,"y":34409.0},{"building":"smithy","dialogue":"Ostrze kupisz u Mio. Po zapoznaniu się z miastem mogę nauczyć cię wyposażania broni. Ulepszenie założonego ostrza kosztuje 15 monet i dodaje 4 ataku.","id":"accepted-smith","name":"Taro","role":"Kowal","tint":10802687,"x":48029.0,"y":35289.0},{"building":"depot","dialogue":"Skrzynia po prawej należy wyłącznie do tej postaci. Możesz odłożyć przedmioty i materiały oraz odebrać je później. Najpierw zdejmij rzeczy, które nosisz. Depozyt jest zapisywany na tym urządzeniu.","id":"accepted-keeper","name":"Nela","role":"Opiekunka depozytu","tint":14931099,"x":48909.0,"y":35479.0},{"building":"arena","dialogue":"Manekin nie atakuje i nie daje łupów, monet ani XP. Używaj swoich prawdziwych umiejętności: koszty KI i odnowienia działają normalnie. Licznik pokaże trafienia i obrażenia.","id":"accepted-trainer","name":"Iwo","role":"Mistrz treningu","tint":16765329,"x":49609.0,"y":35339.0},{"building":"inn","dialogue":"Odpoczynek kosztuje 5 monet i przywraca życie oraz KI. Przy pełnych zasobach nic nie zapłacisz.","id":"accepted-innkeeper","name":"Lina","role":"Gospodyni","tint":15578568,"x":49629.0,"y":34379.0},{"building":"hall","dialogue":"Zielona Przystań ma sześć dzielnic usługowych połączonych alejami. Kupcy są na północnym zachodzie, kuźnia na południowym zachodzie, a depozyt przy południowej alei. Gospoda i trening leżą na wschodzie.","id":"accepted-steward","name":"Oren","role":"Opiekun miasta","tint":13295538,"x":48929.0,"y":34179.0},{"building":"verdant-town-1-shop","id":"verdant-town-1-shop-npc","name":"Verdantia — miasto 2 — shop","role":"shop","x":18440.93739,"y":26672.518924999997},{"building":"verdant-town-1-hall","id":"verdant-town-1-hall-npc","name":"Verdantia — miasto 2 — hall","role":"hall","x":19400.93739,"y":26416.518924999997},{"building":"verdant-town-1-inn","id":"verdant-town-1-inn-npc","name":"Verdantia — miasto 2 — inn","role":"inn","x":20360.93739,"y":26672.518924999997},{"building":"verdant-town-1-smithy","id":"verdant-town-1-smithy-npc","name":"Verdantia — miasto 2 — smithy","role":"smithy","x":18440.93739,"y":27952.518924999997},{"building":"verdant-town-1-depot","id":"verdant-town-1-depot-npc","name":"Verdantia — miasto 2 — depot","role":"depot","x":19400.93739,"y":28208.518924999997},{"building":"verdant-town-1-arena","id":"v