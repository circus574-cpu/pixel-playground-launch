class_name PyraStory
extends RefCounted
## What the hero has been told: the introduction of the race, the first-steps tutorial and the conversation topics of the residents.
## The texts live in data/talk.json (generated by scripts/godot/prepare_talk.py); this class keeps only the hero's progress
## (saved in the checkpoint under "story") and picks what a resident can say right now.

signal changed

const DATA_PATH := "res://data/talk.json"
const REWARD_GOLD := 40
## The tutorial: each step is ticked by the first time the hero does the thing.
const STEPS := [
	{"id": "move", "text": "Przejdź się po mieście lewym kciukiem"},
	{"id": "talk", "text": "Porozmawiaj z mieszkańcem (E)"},
	{"id": "attack", "text": "Uderz podstawowym atakiem"},
	{"id": "skill", "text": "Użyj zdolności z paska"},
	{"id": "dodge", "text": "Wykonaj unik"},
	{"id": "shop", "text": "Zajrzyj do sklepu lub kuźni"},
	{"id": "map", "text": "Otwórz mapę świata"},
	{"id": "gate", "text": "Wyjdź za bramę miasta"},
]
const WORLD_TOPIC_ORDER := ["cisza", "chor", "okolica", "podziemia", "dlug"]

static var cache: Dictionary = {}

var intro_seen := false
var steps: Dictionary = {}          # tutorial step id -> true
var talk_seen: Dictionary = {}      # topic id -> true
var rewarded := false
var tutorial_off := false           # the player dismissed the tutorial

static func data() -> Dictionary:
	if cache.is_empty():
		var value: Variant = JSON.parse_string(FileAccess.get_file_as_string(DATA_PATH)) if FileAccess.file_exists(DATA_PATH) else null
		cache = value if value is Dictionary else {"introShared": [], "introRace": {}, "worldTopics": {}, "roleTopics": {}, "reactions": [], "worlds": {}}
	return cache

# ---- introduction -------------------------------------------------------------------------------

## The pages of the story told before the first steps: two shared ones about the Silence, then the race's own.
static func intro(race: String) -> Dictionary:
	var d := data()
	var own: Dictionary = (d.introRace as Dictionary).get(race, {})
	var pages: Array = (d.introShared as Array).duplicate()
	pages.append_array(own.get("pages", []))
	return {"title": str(own.get("title", "Superior")), "pages": pages}

# ---- tutorial -----------------------------------------------------------------------------------

func note(step: String) -> bool:
	if steps.has(step) or tutorial_off or not _is_step(step):
		return false
	steps[step] = true
	changed.emit()
	return true

static func _is_step(step: String) -> bool:
	for s: Dictionary in STEPS:
		if s.id == step:
			return true
	return false

func steps_done() -> int:
	return steps.size()

func tutorial_active() -> bool:
	return intro_seen and not tutorial_off and steps.size() < STEPS.size()

func tutorial_complete() -> bool:
	return steps.size() >= STEPS.size()

## The entry shown in the quest tracker: the next three steps that are not done.
func tracker() -> Array[Dictionary]:
	var out: Array[Dictionary] = []
	if not tutorial_active():
		return out
	var lines: Array = []
	for s: Dictionary in STEPS:
		if not steps.has(s.id) and lines.size() < 3:
			lines.append(str(s.text))
	out.append({"title": "Pierwsze kroki %d/%d" % [steps.size(), STEPS.size()], "lines": lines})
	return out

## True once, when the last step has just been ticked: the caller pays the reward.
func claim_reward() -> bool:
	if rewarded or not tutorial_complete():
		return false
	rewarded = true
	changed.emit()
	return true

func dismiss_tutorial() -> void:
	tutorial_off = true
	changed.emit()

# ---- conversation -------------------------------------------------------------------------------

## Topics a resident of `world` with `role` can talk about: their own trade first, then the five of the world.
static func topics(world: String, role: String) -> Array[Dictionary]:
	var d := data()
	var out: Array[Dictionary] = []
	for t: Dictionary in (d.roleTopics as Dictionary).get(role, []):
		out.append({"id": "r:%s:%s" % [role, t.id], "label": str(t.label), "text": str(t.text)})
	for key: String in WORLD_TOPIC_ORDER:
		var topic: Dictionary = (d.worldTopics as Dictionary).get(key, {})
		var text: String = str((topic.get("text", {}) as Dictionary).get(world, ""))
		if text != "":
			out.append({"id": "w:%s:%s" % [world, key], "label": str(topic.label), "text": text})
	return out

func heard(id: String) -> bool:
	return talk_seen.has(id)

func hear(id: String) -> void:
	if not talk_seen.has(id):
		talk_seen[id] = true
		changed.emit()

func heard_count() -> int:
	return talk_seen.size()

## One remark that answers the hero's situation (flags: hurt, boss, cave, secret, level20, level10, rich, night, novice), or "".
static func reaction(flags: Dictionary, salt: int = 0) -> String:
	var fits: Array[String] = []
	for r: Dictionary in data().reactions:
		if bool(flags.get(str(r.when), false)):
			fits.append(str(r.text))
	if fits.is_empty():
		return ""
	return fits[salt % fits.size()] if fits.size() > 1 and salt > 0 else fits[0]

# ---- save ---------------------------------------------------------------------------------------

func reset() -> void:
	intro_seen = false
	steps = {}
	talk_seen = {}
	rewarded = false
	tutorial_off = false
	changed.emit()

func to_save() -> Dictionary:
	return {"intro": intro_seen, "steps": steps.keys(), "talk": talk_seen.keys(), "rewarded": rewarded, "off": tutorial_off}

## A save without "story" (older versions) counts as a hero who has already been through the introduction.
func from_save(value: Variant) -> void:
	reset()
	if not value is Dictionary:
		intro_seen = true
		tutorial_off = true
		return
	intro_seen = bool(value.get("intro", false))
	rewarded = bool(value.get("rewarded", false))
	tutorial_off = bool(value.get("off", false))
	for id: Variant in value.get("steps", []) if value.get("steps", []) is Array else []:
		if id is String and _is_step(id):
			steps[id] = true
	for id: Variant in value.get("talk", []) if value.get("talk", []) is Array else []:
		if id is String and (id as String).length() < 60:
			talk_seen[id] = true
