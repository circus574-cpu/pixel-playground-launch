+export function getActiveUiThemeRaceId(): HeroRace['id'] {
+  try {
+    if (typeof window !== 'undefined' && window.localStorage) {
+      const val = window.localStorage.getItem(ACTIVE_RACE_THEME_KEY) as HeroRace['id'] | null;
+      if (val && ['planetary', 'sage', 'android', 'legend'].includes(val)) {
+        return val;
+      }
+    }
+  } catch {
+    // ignore
+  }
+  return 'planetary';
+}
+
+export function setActiveUiThemeRaceId(raceId: HeroRace['id']): void {
+  try {
+    if (typeof window !== 'undefined' && window.localStorage) {
+      window.localStorage.setItem(ACTIVE_RACE_THEME_KEY, raceId);
+      const profile = getRaceProfile(raceId);
+      applyRaceThemeToDocument(profile.theme, raceId);
+      window.dispatchEvent(
+        new CustomEvent('ki-legends-active-race-theme-changed', { detail: { raceId, theme: profile.theme } })
+      );
+    }
+  } catch {
+    // ignore
+  }
+}
