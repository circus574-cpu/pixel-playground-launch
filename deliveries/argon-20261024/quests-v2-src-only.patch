+
+const STORAGE_KEY = 'ki_legends_race_editor_profiles_v1';
+const ACTIVE_RACE_THEME_KEY = 'ki_legends_active_race_theme_id_v1';
+
+const inMemoryProfiles: Record<HeroRace['id'], RaceEditorProfile> = {
+  planetary: createDefaultRaceProfile('planetary'),
+  sage: createDefaultRaceProfile('sage'),
+  android: createDefaultRaceProfile('android'),
+  legend: createDefaultRaceProfile('legend'),
+};
+
+export function loadAllRaceProfiles(): Record<HeroRace['id'], RaceEditorProfile> {
+  try {
+    if (typeof window !== 'undefined' && window.localStorage) {
+      const raw = window.localStorage.getItem(STORAGE_KEY);
+      if (raw) {
+        const parsed = JSON.parse(raw) as Partial<Record<HeroRace['id'], RaceEditorProfile>>;
+        for (const r of HERO_RACES) {
+          if (parsed[r.id]) {
+            inMemoryProfiles[r.id] = {
+              raceId: r.id,
+              theme: { ...RACE_THEME_PRESETS[r.id][0], ...parsed[r.id]?.theme },
+              rig: { ...createDefaultRigConfig(r.id), ...parsed[r.id]?.rig },
+              updatedAt: parsed[r.id]?.updatedAt || new Date().toISOString(),
+            };
+          }
+        }
+      }
+    }
+  } catch {
+    // Fallback to in-memory defaults
+  }
+  return { ...inMemoryProfiles };
+}
+
+export function getRaceProfile(raceId: HeroRace['id']): RaceEditorProfile {
+  const all = loadAllRaceProfiles();
+  return all[raceId] || createDefaultRaceProfile(raceId);
+}
+
+export function saveRaceProfile(profile: RaceEditorProfile): void {
+  inMemoryProfiles[profile.raceId] = {
+    ...profile,
+    updatedAt: new Date().toISOString(),
+  };
+  try {
+    if (typeof window !== 'undefined' && window.localStorage) {
+      window.localStorage.setItem(STORAGE_KEY, JSON.stringify(inMemoryProfiles));
+      window.dispatchEvent(
+        new CustomEvent('ki-legends-race-profile-updated', { detail: inMemoryProfiles[profile.raceId] })
+      );
+    }
+  } catch {
+    // Ignore storage quota issues
+  }
+}
+
+export function resetRaceProfileToCanonical(raceId: HeroRace['id']): RaceEditorProfile {
+  const fresh = createDefaultRaceProfile(raceId);
+  saveRaceProfile(fresh);
+  return fresh;
+}
