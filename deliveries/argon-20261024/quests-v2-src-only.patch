+import { Direction, HERO_RACES, HeroRace } from '../../data/heroes';
+import { HeroAnimState, HERO_ANIM_FPS, HERO_ANIM_FRAMES } from './spriteAnimator';
+
+export interface ProvenancePaintedView {
+  file: string;
+  direction: Direction;
+  source_png_sha256: string;
+  sha256: string;
+}
+
+export interface ProvenanceMasterFile {
+  file: string;
+  sha256: string;
+}
+
+export interface RaceProvenanceMetadata {
+  hero: HeroRace['id'];
+  pack_id: string;
+  world: string;
+  owner_status: string;
+  method: string;
+  identity_candidate: string;
+  identity_sha256: string;
+  painted_views_seed: number;
+  views_source: string;
+  painted_views: ProvenancePaintedView[];
+  masters: ProvenanceMasterFile[];
+  pack_manifest_sha256: string;
+  frames_tarball_on_volume: string;
+  tools: {
+    checkpoint: string;
+    diffusers: string;
+    torch: string;
+    rembg_model: string;
+    controlnet: string;
+    ip_adapter: string;
+  };
+  render: {
+    KI_SAFE: number;
+    clips: string;
+  };
+  rights: string;
+}
+
+export interface Stage3RenderContract {
+  version: number;
+  status: string;
+  projection: string;
+  camera: {
+    azimuthDegrees: number;
+    elevationDegrees: number;
+    rollDegrees: number;
+    lockedForAllAssets: boolean;
+  };
+  lighting: {
+    key: string;
+    bakedContactShadow: boolean;
+    auraSeparate: boolean;
+  };
+  character: {
+    sourceFrame: [number, number];
+    runtimeCurrentWorldSize: [number, number];
+    futureWorldHeightTrials: number[];
+    feetAnchor: [number, number];
+    collisionRadiusWorldUnits: number;
+    directions: Direction[];
+    states: Record<string, number>;
+    fps: Record<string, number>;
+    namePattern: string;
+    firstDelivery: string;
+  };
+  validation: string[];
+}
+
+export interface RaceDynamicTheme {
+  id: string;
+  namePl: string;
