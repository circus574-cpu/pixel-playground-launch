+export function createDefaultRaceProfile(raceId: HeroRace['id']): RaceEditorProfile {
+  return {
+    raceId,
+    theme: { ...RACE_THEME_PRESETS[raceId][0] },
+    rig: createDefaultRigConfig(raceId),
+    updatedAt: new Date().toISOString(),
