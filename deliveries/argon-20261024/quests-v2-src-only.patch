+export function applyRaceThemeToDocument(theme: RaceDynamicTheme, raceId: HeroRace['id']): void {
+  if (typeof document === 'undefined') return;
+  const root = document.documentElement;
+  root.style.setProperty('--race-primary', theme.primaryAccent);
+  root.style.setProperty('--race-secondary', theme.secondaryAccent);
+  root.style.setProperty('--race-glow', theme.auraGlow);
+  root.style.setProperty('--race-surface', theme.surfaceTint);
+  root.style.setProperty('--race-border', theme.borderAccent);
+  root.style.setProperty('--race-hp-bar', theme.hpBarColor);
+  root.style.setProperty('--race-ki-bar', theme.kiBarColor);
+  root.setAttribute('data-active-race', raceId);
+}
