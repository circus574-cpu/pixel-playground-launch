+import React, { useState, useEffect, useRef } from 'react';
+import { HERO_RACES, HeroRace, Direction } from '../data/heroes';
+import {
+  HeroAnimState,
+  HERO_ANIM_FRAMES,
+  ensureCleanedHeroSprite,
+  getCachedCleanedHeroSprite,
+  renderAnimatedHero,
+} from '../game/heroes/spriteAnimator';
+import {
+  RaceProvenanceMetadata,
+  Stage3RenderContract,
+  RaceEditorProfile,
+  RaceDynamicTheme,
+  RaceVisualRigConfig,
+  CANONICAL_RACE_PROVENANCE,
+  CANONICAL_STAGE3_CONTRACT,
+  RACE_THEME_PRESETS,
+  fetchRaceProvenance,
+  fetchStage3RenderContract,
+  getRaceProfile,
+  saveRaceProfile,
+  resetRaceProfileToCanonical,
+  setActiveUiThemeRaceId,
+  applyRaceThemeToDocument,
+  computeEffectiveAnimFps,
+} from '../game/heroes/raceMetadata';
+import {
+  Sliders,
+  Palette,
+  Activity,
+  FileJson,
+  RotateCcw,
+  Play,
+  Pause,
+  RotateCw,
+  Check,
+  Copy,
+  Eye,
+  Layers,
+  Crosshair,
+  Shield,
+  Zap,
+  Sparkles,
+  ChevronRight,
+  Wand2,
+} from 'lucide-react';
+
+const DIRECTIONS: { key: Direction; short: string; labelPl: string }[] = [
+  { key: 'down', short: 'S', labelPl: 'Południe (Down)' },
+  { key: 'down-left', short: 'SW', labelPl: 'Pd.-Zach. (Down-Left)' },
+  { key: 'left', short: 'W', labelPl: 'Zachód (Left)' },
+  { key: 'up-left', short: 'NW', labelPl: 'Pn.-Zach. (Up-Left)' },
+  { key: 'up', short: 'N', labelPl: 'Północ (Up)' },
+  { key: 'up-right', short: 'NE', labelPl: 'Pn.-Wsch. (Up-Right)' },
+  { key: 'right', short: 'E', labelPl: 'Wschód (Right)' },
+  { key: 'down-right', short: 'SE', labelPl: 'Pd.-Wsch. (Down-Right)' },
+];
+
+const ANIM_STATES: { key: HeroAnimState; labelPl: string; descPl: string }[] = [
+  { key: 'walk', labelPl: 'Chód (Walk)', descPl: '8 klatek · Naprzemienny krok L/P + wahadło tułowia' },
+  { key: 'attack', labelPl: 'Atak (Attack)', descPl: '8 klatek · Zamach, wypad bojowy i łuk cięcia KI' },
+  { key: 'skill', labelPl: 'Technika KI (Skill)', descPl: '8 klatek · Lewitacja, pieczęć i eksplozja aury' },
+  { key: 'idle', labelPl: 'Oddech (Idle)', descPl: '8 klatek · Oddech bojowy i falowanie szat' },
+  { key: 'hit', labelPl: 'Obrażenia (Hit)', descPl: '4 klatki · Odrzut kierunkowy i błysk trafienia' },
+  { key: 'death', labelPl: 'Upadek (Death)', descPl: '8 klatek · Progresywny upadek na podłoże' },
+];
+
+type EditorWorkspaceTab = 'appearance' | 'animation' | 'theme' | 'metadata';
+
+interface CharacterRaceEditorProps {
+  initialRaceId?: HeroRace['id'];
+  onLaunchCombatWithRace?: (raceId: HeroRace['id']) => void;
+  onActiveThemeChange?: (raceId: HeroRace['id'], theme: RaceDynamicTheme) => void;
+}
+
+export const CharacterRaceEditor: React.FC<CharacterRaceEditorProps> = ({
+  initialRaceId = 'planetary',
+  onLaunchCombatWithRace,
+  onActiveThemeChange,
+}) => {
+  const [selectedRaceId, setSelectedRaceId] = useState<HeroRace['id']>(initialRaceId);
+  const [profile, setProfile] = useState<RaceEditorProfile>(() => getRaceProfile(initialRaceId));
+  const [provenance, setProvenance] = useState<RaceProvenanceMetadata>(
+    () => CANONICAL_RACE_PROVENANCE[initialRaceId]
+  );
+  const [contract, setContract] = useState<Stage3RenderContract>(() => CANONICAL_STAGE3_CONTRACT);
+
+  const [workspaceTab, setWorkspaceTab] = useState<EditorWorkspaceTab>('appearance');
+  const [currentDirection, setCurrentDirection] = useState<Direction>('down');
+  const [activeAnim, setActiveAnim] = useState<HeroAnimState>('walk');
+  const [animFrameIndex, setAnimFrameIndex] = useState<number>(0);
+  const [isPlaying, setIsPlaying] = useState<boolean>(true);
+  const [isTurntableRotating, setIsTurntableRotating] = useState<boolean>(false);
+  const [applyThemeGlobally, setApplyThemeGlobally] = useState<boolean>(true);
+  const [copiedJson, setCopiedJson] = useState<boolean>(false);
+  const [spriteReadyTick, setSpriteReadyTick] = useState<number>(0);
+
+  const mainStageCanvasRef = useRef<HTMLCanvasElement | null>(null);
+  const directionMiniCanvasRefs = useRef<Record<Direction, HTMLCanvasElement | null>>({
+    down: null,
+    'down-left': null,
+    left: null,
+    'up-left': null,
+    up: null,
+    'up-right': null,
+    right: null,
+    'down-right': null,
+  });
+
+  const hero = HERO_RACES.find((r) => r.id === selectedRaceId) || HERO_RACES[0];
+  const totalFrames = HERO_ANIM_FRAMES[activeAnim];
+  const effectiveFps = computeEffectiveAnimFps(activeAnim, profile.rig.fpsMultiplier);
+
+  // Load race profile and provenance.json when race changes
+  useEffect(() => {
+    const loadedProfile = getRaceProfile(selectedRaceId);
+    setProfile(loadedProfile);
+    setProvenance(CANONICAL_RACE_PROVENANCE[selectedRaceId]);
+
+    let active = true;
+    fetchRaceProvenance(selectedRaceId).then((meta) => {
+      if (active) setProvenance(meta);
+    });
+    fetchStage3RenderContract().then((c) => {
+      if (active) setContract(c);
+    });
+
+    if (applyThemeGlobally) {
+      setActiveUiThemeRaceId(selectedRaceId);
+      applyRaceThemeToDocument(loadedProfile.theme, selectedRaceId);
+      onActiveThemeChange?.(selectedRaceId, loadedProfile.theme);
+    }
+
+    return () => {
+      active = false;
+    };
+  }, [selectedRaceId]);
+
+  // Preload and clean all 8 directional master PNGs for the active race
+  useEffect(() => {
+    let mounted = true;
+    Promise.all(DIRECTIONS.map((d) => ensureCleanedHeroSprite(hero, d.key))).then(() => {
+      if (mounted) setSpriteReadyTick((t) => t + 1);
+    });
+    return () => {
+      mounted = false;
+    };
+  }, [hero]);
+
+  // Auto 360 turntable rotation across 8 directions
+  useEffect(() => {
+    if (!isTurntableRotating) return;
+    const timer = setInterval(() => {
+      setCurrentDirection((prev) => {
+        const idx = DIRECTIONS.findIndex((d) => d.key === prev);
+        return DIRECTIONS[(idx + 1) % DIRECTIONS.length].key;
+      });
+    }, 650);
+    return () => clearInterval(timer);
+  }, [isTurntableRotating]);
+
+  // Frame index ticker for timeline scrubber highlight
+  useEffect(() => {
+    if (!isPlaying) return;
+    const intervalMs = Math.max(30, Math.round(1000 / effectiveFps));
+    const timer = setInterval(() => {
+      setAnimFrameIndex((prev) => (prev + 1) % HERO_ANIM_FRAMES[activeAnim]);
+    }, intervalMs);
+    return () => clearInterval(timer);
+  }, [isPlaying, activeAnim, effectiveFps]);
+
+  // 60 FPS Canvas render loop for main stage + 8-direction simultaneous matrix
+  useEffect(() => {
+    let rafId: number;
+    const startTime = performance.now();
+
+    const renderFrame = (now: number) => {
+      const framesCount = HERO_ANIM_FRAMES[activeAnim];
+      let frameIdx = animFrameIndex % framesCount;
+      let subFrame = 0;
+
+      if (isPlaying) {
+        const elapsedSec = (now - startTime) / 1000;
+        const continuous = (elapsedSec * effectiveFps) % framesCount;
+        frameIdx = Math.floor(continuous);
+        subFrame = continuous - frameIdx;
+      }
+
+      const customization = {
+        scaleMultiplier: profile.rig.scaleMultiplier * (profile.rig.worldHeightTrialPx / 96),
+        feetAnchorY: profile.rig.feetAnchorY,
+        collisionRadiusUnits: profile.rig.collisionRadiusUnits,
+        hueShiftDeg: profile.rig.hueShiftDeg,
+        saturationPct: profile.rig.saturationPct,
+        brightnessPct: profile.rig.brightnessPct,
+        contrastPct: profile.rig.contrastPct,
+        strideAmplitude: profile.rig.strideAmplitude,
+        clothWaveIntensity: profile.rig.clothWaveIntensity,
+        attackLungeDistance: profile.rig.attackLungeDistance,
+        skillLevitationHeight: profile.rig.skillLevitationHeight,
+        breathingDepth: profile.rig.breathingDepth,
+        auraIntensity: profile.rig.auraIntensity,
+        auraColorOverride: profile.theme.primaryAccent,
+        secondaryGlowOverride: profile.theme.auraGlow,
+        showFeetAnchor: profile.rig.showFeetAnchor,
+        showCollisionCircle: profile.rig.showCollisionCircle,
+      };
+
+      // 1. Render Main Stage Canvas
+      const stageCanvas = mainStageCanvasRef.current;
+      if (stageCanvas) {
+        const ctx = stageCanvas.getContext('2d');
+        if (ctx) {
+          ctx.clearRect(0, 0, stageCanvas.width, stageCanvas.height);
+          renderAnimatedHero(
+            ctx,
+            hero,
+            currentDirection,
+            stageCanvas.width / 2,
+            stageCanvas.height - 34,
+            290,
+            {
+              state: activeAnim,
+              frameIndex: frameIdx,
+              subFrame,
+              useCleanedSprite: profile.rig.useCleanedSprite,
+              showAura: profile.rig.showAura,
+              customization,
+            }
+          );
+        }
+      }
+
+      // 2. Render 8-Direction Simultaneous Miniature Matrix
+      for (const dirItem of DIRECTIONS) {
+        const miniCanvas = directionMiniCanvasRefs.current[dirItem.key];
+        if (!miniCanvas) continue;
+        const mCtx = miniCanvas.getContext('2d');
+        if (!mCtx) continue;
+        mCtx.clearRect(0, 0, miniCanvas.width, miniCanvas.height);
+        renderAnimatedHero(
+          mCtx,
+          hero,
+          dirItem.key,
+          miniCanvas.width / 2,
+          miniCanvas.height - 10,
+          78,
+          {
+            state: activeAnim,
+            frameIndex: frameIdx,
+            subFrame,
+            useCleanedSprite: profile.rig.useCleanedSprite,
+            showAura: profile.rig.showAura,
+            customization: {
+              ...customization,
+              scaleMultiplier: 1.0,
+              showFeetAnchor: false,
+              showCollisionCircle: false,
+            },
+          }
+        );
+      }
+
+      if (isPlaying) {
+        rafId = requestAnimationFrame(renderFrame);
+      }
+    };
+
+    rafId = requestAnimationFrame(renderFrame);
+    return () => cancelAnimationFrame(rafId);
+  }, [
+    hero,
+    currentDirection,
+    activeAnim,
+    animFrameIndex,
+    isPlaying,
+    effectiveFps,
+    profile,
+    spriteReadyTick,
+  ]);
+
+  const updateRig = (patch: Partial<RaceVisualRigConfig>) => {
+    const nextProfile: RaceEditorProfile = {
+      ...profile,
+      rig: { ...profile.rig, ...patch },
+      updatedAt: new Date().toISOString(),
+    };
+    setProfile(nextProfile);
+    saveRaceProfile(nextProfile);
+  };
+
+  const updateTheme = (patch: Partial<RaceDynamicTheme>) => {
+    const nextTheme: RaceDynamicTheme = {
+      ...profile.theme,
+      ...patch,
+      id: patch.id || `${selectedRaceId}-custom`,
+    };
+    const nextProfile: RaceEditorProfile = {
+      ...profile,
+      theme: nextTheme,
+      updatedAt: new Date().toISOString(),
+    };
+    setProfile(nextProfile);
+    saveRaceProfile(nextProfile);
+    if (applyThemeGlobally) {
+      applyRaceThemeToDocument(nextTheme, selectedRaceId);
+      onActiveThemeChange?.(selectedRaceId, nextTheme);
+    }
+  };
+
+  const handleResetToCanonical = () => {
+    const fresh = resetRaceProfileToCanonical(selectedRaceId);
+    setProfile(fresh);
+    if (applyThemeGlobally) {
+      applyRaceThemeToDocument(fresh.theme, selectedRaceId);
+      onActiveThemeChange?.(selectedRaceId, fresh.theme);
+    }
+  };
+
+  const handleCopyJson = () => {
+    const payload = {
+      raceId: selectedRaceId,
+      provenancePackId: provenance.pack_id,
+      paintedViewsSeed: provenance.painted_views_seed,
+      stage3ContractVersion: contract.version,
+      theme: profile.theme,
+      rig: profile.rig,
+    };
+    if (typeof navigator !== 'undefined' && navigator.clipboard) {
+      navigator.clipboard.writeText(JSON.stringify(payload, null, 2));
+      setCopiedJson(true);
+      setTimeout(() => setCopiedJson(false), 2000);
+    }
+  };
+
+  const activeSpriteRecord = getCachedCleanedHeroSprite(hero.id, currentDirection);
+  const currentMasterMeta = provenance.masters.find((m) =>
+    m.file.includes(`master-${currentDirection}.png`)
+  );
+  const currentPaintedViewMeta = provenance.painted_views.find(
+    (v) => v.direction === currentDirection
+  );
+
+  return (
+    <div
+      className="space-y-6 text-stone-100"
+      style={
+        {
+          '--editor-accent': profile.theme.primaryAccent,
+          '--editor-secondary': profile.theme.secondaryAccent,
+          '--editor-glow': profile.theme.auraGlow,
+          '--editor-surface': profile.theme.surfaceTint,
+          '--editor-border': profile.theme.borderAccent,
+        } as React.CSSProperties
+      }
+    >
+      {/* Top Studio Header */}
+      <div
+        className="rounded-2xl border p-5 transition-colors"
+        style={{
+          backgroundColor: 'rgba(12, 10, 9, 0.9)',
+          borderColor: `${profile.theme.primaryAccent}44`,
+          boxShadow: `0 12px 40px -16px ${profile.theme.primaryAccent}33`,
+        }}
+      >
+        <div className="flex flex-col lg:flex-row lg:items-center justify-between gap-4">
+          <div>
+            <div
+              className="text-xs font-mono uppercase tracking-widest flex items-center gap-2"
+              style={{ color: profile.theme.primaryAccent }}
+            >
+              <Sparkles className="w-3.5 h-3.5" />
+              <span>
+                Character Race Editor · Pack: {provenance.pack_id} · Seed #{provenance.painted_views_seed} · Stage 3 Contract v{contract.version}
+              </span>
+            </div>
+            <h2 className="text-2xl sm:text-3xl font-black tracking-tight text-white mt-1">
+              Edytor Rasy, Animacji 2D i Dynamicznego Motywu UI
+            </h2>
+            <p className="text-sm text-stone-400 mt-1 max-w-3xl">
+              Zarządzaj wyglądem 8-kierunkowych masterów ({provenance.tools.rembg_model}), kalibracją kotwicy stóp, kinematyką 6 stanów ruchu oraz dynamiczną paletą kolorystyczną interfejsu rasy.
+            </p>
+          </div>
+
+          <div className="flex flex-wrap items-center gap-2.5">
+            <button
+              onClick={handleResetToCanonical}
+              className="flex items-center gap-1.5 px-3.5 py-2 rounded-lg text-xs font-mono font-semibold border border-stone-700 bg-stone-900 hover:bg-stone-800 text-stone-300 transition-colors cursor-pointer"
+            >
+              <RotateCcw className="w-3.5 h-3.5" />
+              Reset Kanoniczny
+            </button>
+
+            <button
+              onClick={handleCopyJson}
+              className="flex items-center gap-1.5 px-3.5 py-2 rounded-lg text-xs font-mono font-semibold border border-stone-700 bg-stone-900 hover:bg-stone-800 text-stone-200 transition-colors cursor-pointer"
+            >
+              {copiedJson ? (
+                <>
+                  <Check className="w-3.5 h-3.5 text-emerald-400" />
+                  Skopiowano JSON
+                </>
+              ) : (
+                <>
+                  <Copy className="w-3.5 h-3.5" />
+                  Kopiuj Profil JSON
+                </>
+              )}
+            </button>
+
+            {onLaunchCombatWithRace && (
+              <button
+                onClick={() => onLaunchCombatWithRace(selectedRaceId)}
+                className="flex items-center gap-1.5 px-4 py-2 rounded-lg text-xs font-bold text-stone-950 transition-all cursor-pointer shadow-lg"
+                style={{
+                  backgroundColor: profile.theme.primaryAccent,
+                  boxShadow: `0 6px 20px -4px ${profile.theme.primaryAccent}80`,
+                }}
+              >
+                Testuj {hero.polishName} w Walce
+                <ChevronRight className="w-4 h-4" />
+              </button>
+            )}
+          </div>
+        </div>
+
+        {/* 4 Race Selector Cards with Dynamic Theme Indicator */}
+        <div className="grid grid-cols-2 lg:grid-cols-4 gap-3 mt-5">
+          {HERO_RACES.map((r) => {
+            const rProfile = getRaceProfile(r.id);
+            const rMeta = CANONICAL_RACE_PROVENANCE[r.id];
+            const isSelected = r.id === selectedRaceId;
+            return (
+              <button
+                key={r.id}
+                onClick={() => {
+                  setSelectedRaceId(r.id);
+                  setAnimFrameIndex(0);
+                }}
+                className={`p-3.5 rounded-xl border text-left transition-all cursor-pointer relative overflow-hidden ${
+                  isSelected ? 'bg-stone-900/95 shadow-lg' : 'bg-stone-950/60 border-stone-800/90 hover:border-stone-700'
+                }`}
+                style={
+                  isSelected
+                    ? {
+                        borderColor: rProfile.theme.primaryAccent,
+                        boxShadow: `0 0 0 1px ${rProfile.theme.primaryAccent}55, 0 8px 24px -8px ${rProfile.theme.primaryAccent}40`,
+                      }
+                    : undefined
+                }
+              >
