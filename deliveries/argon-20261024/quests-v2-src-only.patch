+/**
+ * Fetches live stage3-render-contract.json from `/art/pipeline/stage3-render-contract.json`
+ * with canonical fallback.
+ */
+export async function fetchStage3RenderContract(): Promise<Stage3RenderContract> {
+  try {
+    if (typeof fetch !== 'undefined') {
+      const res = await fetch('/art/pipeline/stage3-render-contract.json');
+      if (res.ok) {
+        const data = (await res.json()) as Stage3RenderContract;
+        if (data && data.character && Array.isArray(data.validation)) {
+          return data;
+        }
+      }
+    }
+  } catch {
+    // Fallback to canonical contract
+  }
+  return CANONICAL_STAGE3_CONTRACT;
+}
