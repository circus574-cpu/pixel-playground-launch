+/**
+ * Fetches live provenance.json from `/art/production/heroes/<race>/painted-v1/provenance.json`
+ * with canonical fallback when running in headless test environments.
+ */
+export async function fetchRaceProvenance(raceId: HeroRace['id']): Promise<RaceProvenanceMetadata> {
+  try {
+    if (typeof fetch !== 'undefined') {
+      const res = await fetch(`/art/production/heroes/${raceId}/painted-v1/provenance.json`);
+      if (res.ok) {
+        const data = (await res.json()) as RaceProvenanceMetadata;
+        if (data && data.hero === raceId && Array.isArray(data.masters)) {
+          return data;
+        }
+      }
+    }
+  } catch {
+    // Fallback to embedded canonical provenance
+  }
+  return CANONICAL_RACE_PROVENANCE[raceId];
+}
