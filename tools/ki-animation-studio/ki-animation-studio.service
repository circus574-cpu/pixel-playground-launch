[Unit]
Description=KI Legends Animation Studio — Kombajn do Animacji 16 CPU
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/srv/ki-animation-studio
Environment="KI_STUDIO_PORT=8090"
Environment="OMP_NUM_THREADS=16"
Environment="OPENBLAS_NUM_THREADS=16"
ExecStart=/srv/ki-animation-studio/.venv/bin/python -m uvicorn backend.server:app --host 0.0.0.0 --port 8090 --workers 2
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
