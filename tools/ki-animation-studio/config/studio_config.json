      "hit": { "frames": 4, "fps": 16, "loop": false, "description": "Krótka reakcja na obrażenia (0.25s)" },
      "death": { "frames": 8, "fps": 10, "loop": false, "description": "Upadek i pokonanie postaci (0.80s)" },
      "respawn": { "frames": 8, "fps": 12, "loop": false, "description": "Odrodzenie w strumieniu energii KI (0.67s)" }
    }
  }
